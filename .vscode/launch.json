{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Autobook (window)",
      "type": "debugpy",
      "request": "launch",
      "module": "autobook",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Prepare sample (no window)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_prepare.py",
      "args": ["${workspaceFolder}/samples/JMF-26-GS-3844 SEA CA.csv"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
